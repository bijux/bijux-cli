{
  "schema_version": "foundation-module-surface-lanes/v1",
  "binary_only_crates": [
    "bijux-dag-cli"
  ],
  "crates": [
    {
      "crate": "bijux-cli",
      "default_internal_lane": "private",
      "stable_public_modules": ["api", "contracts", "sdk"],
      "experimental_public_modules": [],
      "simulated_public_modules": []
    },
    {
      "crate": "bijux-cli-python",
      "default_internal_lane": "private",
      "stable_public_modules": [],
      "experimental_public_modules": [],
      "simulated_public_modules": []
    },
    {
      "crate": "bijux-dag-core",
      "default_internal_lane": "private",
      "stable_public_modules": [
        "builder",
        "canonical",
        "compile",
        "composition",
        "contract",
        "edge",
        "effects",
        "error",
        "expansion",
        "fingerprint",
        "graph",
        "input",
        "meta",
        "model",
        "node",
        "parse",
        "planner",
        "prelude",
        "resolve",
        "resources",
        "semantics",
        "stable",
        "topology",
        "trigger_rules",
        "validate"
      ],
      "experimental_public_modules": ["experimental"],
      "simulated_public_modules": []
    },
    {
      "crate": "bijux-dag-runtime",
      "default_internal_lane": "private",
      "stable_public_modules": ["prelude", "stable"],
      "experimental_public_modules": ["experimental"],
      "simulated_public_modules": ["simulated_platform"]
    },
    {
      "crate": "bijux-dag-artifacts",
      "default_internal_lane": "private",
      "stable_public_modules": [
        "fs",
        "hardening",
        "hash",
        "index",
        "lineage",
        "models",
        "paths",
        "platform",
        "promotion",
        "proof",
        "prelude",
        "retention",
        "schema",
        "services",
        "stable",
        "store"
      ],
      "experimental_public_modules": ["experimental"],
      "simulated_public_modules": []
    },
    {
      "crate": "bijux-dag-app",
      "default_internal_lane": "private",
      "stable_public_modules": ["prelude", "stable"],
      "experimental_public_modules": ["experimental"],
      "simulated_public_modules": []
    },
    {
      "crate": "bijux-dag-testkit",
      "default_internal_lane": "private",
      "stable_public_modules": ["fake_adapter", "workflows"],
      "experimental_public_modules": ["product_scenarios"],
      "simulated_public_modules": []
    },
    {
      "crate": "bijux-dev",
      "default_internal_lane": "private",
      "stable_public_modules": ["cli", "contracts", "infra", "reports", "runtime", "schema", "suites"],
      "experimental_public_modules": [],
      "simulated_public_modules": []
    }
  ]
}
