{
  "node_id": "shell-transform",
  "isolation_mode": "Subprocess",
  "inputs": [
    {"name": "in", "value_type": "artifact_ref", "required": true}
  ],
  "outputs": [
    {
      "name": "out",
      "path": "shell/out.json",
      "schema_name": "bijux.output.file",
      "schema_version": "v0.1"
    }
  ],
  "effects": [
    {"effect": "filesystem", "classification": "Required"}
  ],
  "retry_policy": {
    "max_attempts": 1,
    "backoff_strategy": "Linear",
    "backoff_ms": 10,
    "jitter_ms": 0,
    "timeout_retry_policy": "ByFailureClass",
    "retryable_failure_classes": ["ExecutionTransient"],
    "retryable_exit_codes": []
  },
  "timeout_policy": {
    "queue_timeout_ms": null,
    "execution_timeout_ms": 1000,
    "total_budget_timeout_ms": 5000
  },
  "idempotency_mode": "Recommended",
  "nondeterministic_allowed": false,
  "output_materialization_policy": "Copy",
  "sandbox_policy": {
    "isolation_mode": "Subprocess",
    "deny_network": true,
    "deny_env": false,
    "deny_clock": false,
    "clean_env": true
  }
}
