{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductMountDescriptor",
  "type": "object",
  "required": [
    "control_entrypoint",
    "display_name",
    "entrypoint",
    "help",
    "namespace"
  ],
  "properties": {
    "aliases": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Namespace"
      }
    },
    "capabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "control_entrypoint": {
      "$ref": "#/definitions/ProductEntrypoint"
    },
    "display_name": {
      "type": "string"
    },
    "entrypoint": {
      "$ref": "#/definitions/ProductEntrypoint"
    },
    "help": {
      "$ref": "#/definitions/ProductHelpMetadata"
    },
    "namespace": {
      "$ref": "#/definitions/Namespace"
    },
    "version": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "Namespace": {
      "description": "Canonical command namespace segment.",
      "type": "string"
    },
    "ProductEntrypoint": {
      "type": "object",
      "required": [
        "command",
        "kind"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ProductEntrypointKind"
        }
      }
    },
    "ProductEntrypointKind": {
      "type": "string",
      "enum": [
        "binary",
        "python_module",
        "python_console_script",
        "plugin_process",
        "embedded_rust"
      ]
    },
    "ProductHelpMetadata": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        }
      }
    }
  }
}