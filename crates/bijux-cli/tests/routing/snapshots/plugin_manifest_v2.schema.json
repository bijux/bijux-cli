{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PluginManifestV2",
  "description": "Current plugin manifest contract.",
  "type": "object",
  "required": [
    "capabilities",
    "compatibility",
    "entrypoint",
    "manifest_version",
    "name",
    "namespace",
    "schema_version",
    "version"
  ],
  "properties": {
    "aliases": {
      "description": "Declared command aliases.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "description": "Declared capabilities.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/PluginCapability"
      }
    },
    "compatibility": {
      "description": "Compatibility range for host CLI.",
      "allOf": [
        {
          "$ref": "#/definitions/CompatibilityRange"
        }
      ]
    },
    "entrypoint": {
      "description": "Plugin entrypoint (binary path or module symbol).",
      "type": "string"
    },
    "kind": {
      "description": "Plugin execution kind.",
      "default": "delegated",
      "allOf": [
        {
          "$ref": "#/definitions/PluginKind"
        }
      ]
    },
    "manifest_version": {
      "description": "Manifest contract version.",
      "type": "string"
    },
    "name": {
      "description": "Plugin name.",
      "type": "string"
    },
    "namespace": {
      "description": "Declared top-level namespace.",
      "allOf": [
        {
          "$ref": "#/definitions/Namespace"
        }
      ]
    },
    "schema_version": {
      "description": "Plugin schema version.",
      "type": "string"
    },
    "version": {
      "description": "Plugin version.",
      "type": "string"
    }
  },
  "definitions": {
    "CompatibilityRange": {
      "description": "Stable compatibility range contract for plugins and features.",
      "type": "object",
      "required": [
        "min_inclusive"
      ],
      "properties": {
        "max_exclusive": {
          "description": "Optional maximum supported version exclusive.",
          "type": [
            "string",
            "null"
          ]
        },
        "min_inclusive": {
          "description": "Minimum supported version inclusive.",
          "type": "string"
        }
      }
    },
    "Namespace": {
      "description": "Canonical command namespace segment.",
      "type": "string"
    },
    "PluginCapability": {
      "description": "Stable plugin capability declaration.",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "Capability identifier.",
          "type": "string"
        },
        "version": {
          "description": "Optional capability version.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PluginKind": {
      "description": "Stable plugin kind declaration.",
      "oneOf": [
        {
          "description": "Future in-process plugin ABI.",
          "type": "string",
          "enum": [
            "native"
          ]
        },
        {
          "description": "Delegated plugin loaded through host contract bridge.",
          "type": "string",
          "enum": [
            "delegated"
          ]
        },
        {
          "description": "Python delegated plugin runtime.",
          "type": "string",
          "enum": [
            "python"
          ]
        },
        {
          "description": "External executable plugin.",
          "type": "string",
          "enum": [
            "external-exec"
          ]
        }
      ]
    }
  }
}