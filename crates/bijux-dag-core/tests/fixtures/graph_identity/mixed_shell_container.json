    {"id":"container","kind":"container","inputs":["in"],"outputs":[{"name":"out","path":"container/out.txt"}],"effects":["filesystem"],"container":{"image":"alpine:3.20","argv":["/bin/sh","-lc","cat in > container.out"],"engine":"docker"}}
