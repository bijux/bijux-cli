    {
      "family": "inspect",
      "commands": ["dag.run-show", "dag.run-inspect", "dag.run-id-explain"],
      "schemas": [
        "configs/schema/operator/run_show.schema.json",
        "configs/schema/operator/run_inspect.schema.json",
        "configs/schema/operator/run_id_explain.schema.json"
      ],
      "lockstep_markers": [
        "run_show_json_schema_examples_lockstep",
        "run_inspect_json_schema_examples_lockstep",
        "run_id_explain_json_schema_examples_lockstep"
      ]
    },
