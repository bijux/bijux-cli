      "source_report": "docs/reports/foundation/replay_proof_generation_benchmarks.md"
    },
    {
      "scenario_id": "semantic-diff-equivalence",
      "supported_claim": "replay_diff_proof",
      "gate_class": "gating",
      "noise_class": "medium",
      "threshold_assertion": "docs/reports/foundation/benchmark_threshold_assertions_semantic_diff_equivalence.json",
      "source_report": "docs/reports/foundation/semantic_diff_explain_benchmarks.md"
    },
    {
      "scenario_id": "runtime-scheduler-helper-boundary",
      "supported_claim": "runtime_scheduler",
      "gate_class": "advisory",
      "noise_class": "high",
      "threshold_assertion": "docs/reports/foundation/benchmark_threshold_assertions_runtime_helpers.json",
      "source_report": "docs/reports/foundation/runtime_scheduler_helper_boundary_benchmark.md"
    }
  ],
  "roadmap_pillars": {
    "identity_and_determinism": [
      "graph_identity"
    ],
    "operator_read_paths": [
      "run_history",
      "artifact_trace"
    ],
    "replay_and_diff_integrity": [
      "replay_diff_proof"
    ],
    "runtime_scaling_safety": [
      "runtime_scheduler"
    ]
