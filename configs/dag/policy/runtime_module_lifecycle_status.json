  "quarantine_prefixes": [
    "internal/analysis/",
    "internal/ext/",
    "internal/identity/",
    "internal/workflow/",
    "backend/distributed/"
  ],
  "expiration_criteria": {
    "experimental": "must define graduation owner and stable entry criteria before public exposure",
    "speculative": "must define owner repository migration plan or removal deadline"
  }
}
