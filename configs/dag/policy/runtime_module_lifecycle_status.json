{
  "format": "runtime-module-lifecycle-status/v1",
  "runtime_src_dir": "crates/bijux-dag-runtime/src",
  "allowed_lifecycle_status": [
    "core",
    "adapter",
    "operator-support",
    "experimental",
    "speculative"
