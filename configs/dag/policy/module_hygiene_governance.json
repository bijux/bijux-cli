{
  "policy_version": "1",
  "governance_rules": {
    "new_top_level_modules_require_ownership_classification": true,
    "new_large_modules_require_split_rationale": true,
    "new_large_files_require_split_plan": true,
    "new_tiny_wrapper_modules_require_justification": true,
    "module_hygiene_drift_is_release_gate": true
  },
  "ownership_classification_policy": {
    "owner_map_source": "contracts/foundation/module_surface_lanes.v1.json",
    "required_for_new_top_level_module": true
  },
  "large_module_policy": {
    "threshold_lines": 500,
    "split_rationale_required": true,
    "report": "docs/reports/foundation/MODULE_INVENTORY_OVER_500_LINES.md"
  },
  "very_large_module_policy": {
    "threshold_lines": 1000,
    "split_plan_required": true,
    "report": "docs/reports/foundation/module_inventory_over_1000_lines.md"
  },
  "tiny_wrapper_policy": {
    "threshold_lines": 10,
    "justification_required": true,
    "report": "docs/reports/foundation/MODULE_INVENTORY_UNDER_10_LINES_REVIEW.md"
  },
  "dashboard": {
    "path": "docs/reports/foundation/repo_tree_health_dashboard.md",
    "required": true
  }
}
