{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bijux.dev/schema/planner_explain.schema.json",
  "title": "Planner Explain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "boundary_note",
    "diagnostics"
  ],
  "properties": {
    "boundary_note": {
      "type": "string"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "message"
        ],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["error", "warning"]},
          "message": {"type": "string"},
          "node_id": {"type": ["string", "null"]}
        }
      }
    }
  }
}
