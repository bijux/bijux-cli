{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bijux.dev/schema/run-manifest/v0.1",
  "title": "BijuxRunManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "created_unix_ms", "started_unix_ms", "finished_unix_ms",
    "graph_snapshot", "status", "spec", "graph_fingerprint", "tool_version",
    "jobs", "adapters", "node_counts", "policy"
  ],
  "properties": {
    "manifest_version": {"type": "string"},
    "run_id": {"type": "string"},
    "created_unix_ms": {"type": "integer"},
    "started_unix_ms": {"type": "integer"},
    "finished_unix_ms": {"type": "integer"},
    "graph_snapshot": {"type": "string"},
    "status": {"type": "string"},
    "spec": {"type": "string"},
    "graph_fingerprint": {"type": "string"},
    "tool_version": {"type": "string"},
    "jobs": {"type": "integer"},
    "adapters": {"type": "array"},
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "node_fingerprint",
          "name",
          "path",
          "kind",
          "media_type",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "node_id": {"type": "string"},
          "node_fingerprint": {"type": "string"},
          "name": {"type": "string"},
          "path": {"type": "string"},
          "kind": {"type": "string"},
          "media_type": {"type": "string"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string"},
          "promotable": {"type": "boolean"}
        }
      }
    },
    "node_counts": {"type": "object"},
    "policy": {"type": "object"},
    "cache_mode": {"type": ["string", "null"]},
    "cache_dir": {"type": ["string", "null"]},
    "run_timeout_ms": {"type": ["integer", "null"]},
    "run_timeout_behavior": {"type": ["string", "null"]},
    "run_cancellation_cause": {"type": ["string", "null"]},
    "run_metadata": {"type": ["object", "null"]},
    "run_summary": {"type": ["object", "null"]}
  }
}
