{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bijux.dev/schema/evidence_cache_metadata.schema.json",
  "type": "object",
  "required": [
    "version",
    "owner",
    "corrupt_fixtures",
    "scenarios",
    "cache_proof_outcomes",
    "replay_outcomes",
    "consumer_boundaries"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "corrupt_fixtures": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["corruption_class", "expected_diagnostic"],
        "properties": {
          "corruption_class": { "type": "string", "minLength": 1 },
          "expected_diagnostic": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "scenarios": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["coverage"],
        "properties": {
          "coverage": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "cache_proof_outcomes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "replay_outcomes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "consumer_boundaries": {
      "type": "object",
      "required": ["cache_allowed_consumers", "replay_allowed_consumers"],
      "properties": {
        "cache_allowed_consumers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "replay_allowed_consumers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
