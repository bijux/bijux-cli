{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bijux.dev/schema/evidence_perf_metadata.schema.json",
  "type": "object",
  "required": ["version", "owner", "scenarios", "baselines"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "scenarios": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["workload_class", "budget_class", "threshold_owner", "release_blocking"],
        "properties": {
          "workload_class": { "type": "string", "minLength": 1 },
          "budget_class": { "type": "string", "minLength": 1 },
          "threshold_owner": { "type": "string", "minLength": 1 },
          "release_blocking": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "baselines": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
