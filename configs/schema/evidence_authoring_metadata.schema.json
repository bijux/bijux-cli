{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bijux.dev/schema/evidence_authoring_metadata.schema.json",
  "type": "object",
  "required": ["version", "owner", "assets"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "group",
          "authoring_mode",
          "expected_validation",
          "expected_lowering",
          "command_surfaces",
          "consumers"
        ],
        "properties": {
          "group": {
            "type": "string",
            "enum": ["examples", "patterns", "negative", "minimal"]
          },
          "authoring_mode": {
            "type": "string",
            "enum": ["normative", "illustrative"]
          },
          "expected_validation": {
            "type": "string",
            "enum": ["pass", "fail"]
          },
          "expected_lowering": {
            "type": "string",
            "enum": ["required", "optional", "none"]
          },
          "command_surfaces": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "expected_rule_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
