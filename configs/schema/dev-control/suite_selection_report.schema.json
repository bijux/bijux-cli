    "selected_suite_ids": {"type": "array", "items": {"type": "string"}},
    "skipped_domain": {"type": "array", "items": {"type": "string"}},
    "skipped_slow": {"type": "array", "items": {"type": "string"}},
    "skipped_internal": {"type": "array", "items": {"type": "string"}},
    "skipped_disabled": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
