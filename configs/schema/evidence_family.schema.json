{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bijux.dev/schema/evidence_family.schema.json",
  "title": "Evidence Family",
  "type": "object",
  "required": ["family_id", "version", "owner", "canonical_location", "consumer_surfaces"],
  "properties": {
    "family_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "trust_property_protected": { "type": "string", "minLength": 1 },
    "consumer_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "canonical_location": { "type": "string", "minLength": 1 },
    "implementation_status": {
      "type": "string",
      "enum": ["implemented", "simulated"]
    },
    "release_blocking": { "type": "boolean" }
  },
  "additionalProperties": true
}
