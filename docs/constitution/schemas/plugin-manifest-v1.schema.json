{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PluginManifestV1",
  "description": "Stable plugin manifest contract.",
  "type": "object",
  "required": [
    "capabilities",
    "compatibility",
    "name",
    "namespace",
    "schema_version",
    "version"
  ],
  "properties": {
    "capabilities": {
      "description": "Declared capabilities.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/PluginCapability"
      }
    },
    "compatibility": {
      "description": "Compatibility range for host CLI.",
      "allOf": [
        {
          "$ref": "#/definitions/CompatibilityRange"
        }
      ]
    },
    "name": {
      "description": "Plugin name.",
      "type": "string"
    },
    "namespace": {
      "description": "Declared top-level namespace.",
      "allOf": [
        {
          "$ref": "#/definitions/Namespace"
        }
      ]
    },
    "schema_version": {
      "description": "Plugin schema version.",
      "type": "string"
    },
    "version": {
      "description": "Plugin version.",
      "type": "string"
    }
  },
  "definitions": {
    "CompatibilityRange": {
      "description": "Stable compatibility range contract for plugins and features.",
      "type": "object",
      "required": [
        "min_inclusive"
      ],
      "properties": {
        "max_exclusive": {
          "description": "Optional maximum supported version exclusive.",
          "type": [
            "string",
            "null"
          ]
        },
        "min_inclusive": {
          "description": "Minimum supported version inclusive.",
          "type": "string"
        }
      }
    },
    "Namespace": {
      "description": "Canonical command namespace segment.",
      "type": "string"
    },
    "PluginCapability": {
      "description": "Stable plugin capability declaration.",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "Capability identifier.",
          "type": "string"
        },
        "version": {
          "description": "Optional capability version.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}