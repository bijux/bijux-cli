{
  "spec": "bijux-dag/v0.1",
  "meta": {
    "name": "observability-gold-standard",
    "description": "Demo DAG for retries, cache behavior, branching, and backfill-friendly structure",
    "owners": ["platform"],
    "tags": ["observability", "retry", "cache", "branching", "backfill"]
  },
  "nodes": [
    {
      "id": "seed",
      "kind": "const",
      "inputs": [],
      "outputs": [{"name": "out", "path": "seed/out.json"}],
      "params": {"value": {"window": "2026-03-06", "batch": "daily"}}
    },
    {
      "id": "extract",
      "kind": "shell",
      "inputs": ["in"],
      "outputs": [{"name": "out", "path": "extract/out.json"}],
      "params": {"argv": ["sh", "-c", "cat inputs/seed/in > outputs/extract.json"]}
    },
    {
      "id": "transform_fast",
      "kind": "shell",
      "inputs": ["in"],
      "outputs": [{"name": "out", "path": "transform_fast/out.json"}],
      "params": {"argv": ["sh", "-c", "cat inputs/extract/in > outputs/transform_fast.json"]}
    },
    {
      "id": "transform_slow",
      "kind": "shell",
      "inputs": ["in"],
      "outputs": [{"name": "out", "path": "transform_slow/out.json"}],
      "params": {"argv": ["sh", "-c", "cat inputs/extract/in > outputs/transform_slow.json"]}
    },
    {
      "id": "load",
      "kind": "shell",
      "inputs": ["left", "right"],
      "outputs": [{"name": "out", "path": "load/out.json"}],
      "params": {"argv": ["sh", "-c", "cat inputs/left/left inputs/right/right > outputs/load.json"]}
    }
  ],
  "edges": [
    {"from": {"node_id": "seed", "port": "out"}, "to": {"node_id": "extract", "port": "in"}},
    {"from": {"node_id": "extract", "port": "out"}, "to": {"node_id": "transform_fast", "port": "in"}},
    {"from": {"node_id": "extract", "port": "out"}, "to": {"node_id": "transform_slow", "port": "in"}},
    {"from": {"node_id": "transform_fast", "port": "out"}, "to": {"node_id": "load", "port": "left"}},
    {"from": {"node_id": "transform_slow", "port": "out"}, "to": {"node_id": "load", "port": "right"}}
  ]
}
