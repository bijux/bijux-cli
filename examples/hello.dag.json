{
  "spec": "bijux-dag/v0.1",
  "nodes": [
    {
      "id": "const1",
      "kind": "const",
      "inputs": [],
      "outputs": ["out_const"],
      "params": {"value": "hello"}
    },
    {
      "id": "echo",
      "kind": "shell",
      "inputs": ["in"],
      "outputs": ["out_echo"],
      "params": {"argv": ["echo", "from", "shell"]},
      "effects": ["filesystem"]
    }
  ],
  "edges": [
    {
      "from": {"node_id": "const1", "port": "out_const"},
      "to": {"node_id": "echo", "port": "in"}
    }
  ]
}
