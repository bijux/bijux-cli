# Repository-level docs deployment settings consumed by .github/workflows/deploy-docs.yml.
BIJUX_DOCS_INSTALL_COMMAND="make gh-docs-install"
BIJUX_DOCS_BUILD_COMMAND="make docs-artifact-pages docs-artifact-pages-check docs-check"
BIJUX_DOCS_SITE_DIR="artifacts/docs/site"
BIJUX_DOCS_RUST_TOOLCHAIN="1.86.0"
