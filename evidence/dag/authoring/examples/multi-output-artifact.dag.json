{
  "spec": "bijux-dag/v0.1",
  "meta": {
    "name": "multi-output-artifact",
    "description": "Shell node emits multiple output artifacts for downstream consumers",
    "owners": ["platform"],
    "tags": ["outputs", "multi-artifact"]
  },
  "nodes": [
    {
      "id": "seed",
      "kind": "const",
      "inputs": [],
      "outputs": [{ "name": "value", "path": "seed.txt", "kind": "value", "media_type": "application/json" }],
      "params": { "value": "artifact-seed" }
    },
    {
      "id": "produce_outputs",
      "kind": "shell",
      "inputs": ["seed_input"],
      "outputs": [
        { "name": "primary", "path": "primary.json", "kind": "value", "media_type": "application/json" },
        { "name": "secondary", "path": "secondary.txt", "kind": "log", "required": false, "media_type": "text/plain" }
      ],
      "params": {
        "argv": [
          "/bin/sh",
          "-c",
          "cat <<EOF > ../outputs/primary.json\n{\"status\":\"ready\"}\nEOF\nprintf '%s' \"$(cat ../inputs/seed/seed_input)\" > ../outputs/secondary.txt"
        ]
      },
      "effects": ["filesystem"]
    }
  ],
  "edges": [
    { "from": { "node_id": "seed", "port": "value" }, "to": { "node_id": "produce_outputs", "port": "seed_input" } }
  ]
}
